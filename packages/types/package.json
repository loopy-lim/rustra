{
  "name": "@rustra/types",
  "version": "0.12.1",
  "description": "Shared types and wire contracts for rustra — one Rust core generating type-safe clients for Node, Bun, Tauri, and React Native over a compact binary wire.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "bun test src/*.test.ts",
    "clean": "rm -rf dist dist-test",
    "test:compile": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "keywords": [
    "rustra",
    "types",
    "rust",
    "typescript",
    "ffi",
    "bridge",
    "wire-format",
    "codegen",
    "type-safe",
    "bindings"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopy-lim/rustra.git",
    "directory": "packages/types"
  },
  "bugs": {
    "url": "https://github.com/loopy-lim/rustra/issues"
  },
  "homepage": "https://github.com/loopy-lim/rustra#readme"
}
