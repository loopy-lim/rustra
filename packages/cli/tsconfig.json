{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    // 예외: src 의 인덱스 접근 위반이 105건(codegen 렌더러/분석기 계열, 전부
    // noUncheckedIndexedAccess 유발)이라 플래그만 로컬 비활성한다. src 는 코드젠
    // 렌더러 태스크(T2) 소유라 이번 범위에서 고칠 수 없다 — 위반이 정리되면 이
    // 오버라이드를 제거해 base 상속을 복원한다. 나머지 4개 플래그는 그대로 상속한다.
    "noUncheckedIndexedAccess": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
