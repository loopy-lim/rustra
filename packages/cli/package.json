{
  "name": "@rustra/cli",
  "version": "0.6.0",
  "description": "CLI for rustra-bridge TypeScript code generation",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "rustraTemplate": {
    "cargoRange": "^0.5.0",
    "reactNativeRange": "^0.5.0"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "rustra": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./generate": {
      "types": "./dist/generate.d.ts",
      "import": "./dist/generate.js"
    },
    "./schema-diff": {
      "types": "./dist/schema-diff.d.ts",
      "import": "./dist/schema-diff.js"
    },
    "./validate-engine": {
      "types": "./dist/validate-engine.d.ts",
      "import": "./dist/validate-engine.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "files": [
    "LICENSE",
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "bun test src/doctor.test.ts src/generate.test.ts src/schema-diff.test.ts src/dev.test.ts src/vite.test.ts",
    "test:compile": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@rustra/types": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "rustra",
    "bridge",
    "cli",
    "codegen"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopy-lim/rustra.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/loopy-lim/rustra/issues"
  },
  "homepage": "https://github.com/loopy-lim/rustra#readme"
}
