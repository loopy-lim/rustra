{
  "name": "@rustra/cli",
  "version": "0.4.0",
  "description": "CLI for rustra-bridge TypeScript code generation",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "rustraTemplate": {
    "cargoMinor": "0.4"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "rustra": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./generate": {
      "types": "./dist/generate.d.ts",
      "import": "./dist/generate.js"
    },
    "./schema-diff": {
      "types": "./dist/schema-diff.d.ts",
      "import": "./dist/schema-diff.js"
    },
    "./validate-engine": {
      "types": "./dist/validate-engine.d.ts",
      "import": "./dist/validate-engine.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "files": [
    "LICENSE",
    "dist/codegen.d.ts",
    "dist/codegen.d.ts.map",
    "dist/codegen.js",
    "dist/codegen.js.map",
    "dist/dev.d.ts",
    "dist/dev.d.ts.map",
    "dist/dev.js",
    "dist/dev.js.map",
    "dist/generate.d.ts",
    "dist/generate.d.ts.map",
    "dist/generate.js",
    "dist/generate.js.map",
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "dist/index.js",
    "dist/index.js.map",
    "dist/react-native.d.ts",
    "dist/react-native.d.ts.map",
    "dist/react-native.js",
    "dist/react-native.js.map",
    "dist/schema-diff.d.ts",
    "dist/schema-diff.d.ts.map",
    "dist/schema-diff.js",
    "dist/schema-diff.js.map",
    "dist/schema.d.ts",
    "dist/schema.d.ts.map",
    "dist/schema.js",
    "dist/schema.js.map",
    "dist/validate-engine.d.ts",
    "dist/validate-engine.d.ts.map",
    "dist/validate-engine.js",
    "dist/validate-engine.js.map",
    "dist/vite.d.ts",
    "dist/vite.d.ts.map",
    "dist/vite.js",
    "dist/vite.js.map"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "bun test src/generate.test.ts src/schema-diff.test.ts src/dev.test.ts src/vite.test.ts",
    "test:compile": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@rustra/types": "^0.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "rustra",
    "bridge",
    "cli",
    "codegen"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopy-lim/rustra.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/loopy-lim/rustra/issues"
  },
  "homepage": "https://github.com/loopy-lim/rustra#readme"
}
