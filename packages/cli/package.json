{
  "name": "@rustra/cli",
  "version": "0.1.0",
  "description": "CLI for rustra-bridge TypeScript code generation",
  "license": "MIT",
  "type": "module",
  "bin": {
    "rustra": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./generate": {
      "types": "./dist/generate.d.ts",
      "import": "./dist/generate.js"
    },
    "./schema-diff": {
      "types": "./dist/schema-diff.d.ts",
      "import": "./dist/schema-diff.js"
    },
    "./validate-engine": {
      "types": "./dist/validate-engine.d.ts",
      "import": "./dist/validate-engine.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/generate.test.js dist-test/schema-diff.test.js"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "rustra",
    "bridge",
    "cli",
    "codegen"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/loopy-lim/rustra.git",
    "directory": "packages/"
  },
  "bugs": {
    "url": "https://github.com/loopy-lim/rustra/issues"
  },
  "homepage": "https://github.com/loopy-lim/rustra#readme"
}
