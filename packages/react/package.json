{
  "name": "@rustra/react",
  "version": "0.2.0",
  "description": "React and React Native bindings and hooks for rustra-bridge",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test dist/index.test.js"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "dependencies": {
    "@rustra/types": "^0.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "rustra",
    "bridge",
    "react",
    "react-native",
    "hooks"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopy-lim/rustra.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/loopy-lim/rustra/issues"
  },
  "homepage": "https://github.com/loopy-lim/rustra#readme"
}
