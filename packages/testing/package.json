{
  "name": "@rustra/testing",
  "version": "0.2.1",
  "description": "Testing utilities for rustra-bridge — mock engine and contract gates",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "dist/index.js",
    "dist/index.js.map",
    "dist/contract-gate.d.ts",
    "dist/contract-gate.d.ts.map",
    "dist/contract-gate.js",
    "dist/contract-gate.js.map",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/index.test.js",
    "test:compile": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@rustra/types": "^0.3.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "keywords": [
    "rustra",
    "bridge",
    "testing",
    "mock"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopy-lim/rustra.git",
    "directory": "packages/testing"
  },
  "bugs": {
    "url": "https://github.com/loopy-lim/rustra/issues"
  },
  "homepage": "https://github.com/loopy-lim/rustra#readme"
}
