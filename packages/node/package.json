{
  "name": "@rustra/node",
  "version": "0.6.0",
  "description": "Node adapter for rustra-bridge",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist dist-test",
    "test": "bun test src/index.test.ts",
    "test:compile": "tsc -p tsconfig.test.json",
    "test:node-runtime": "tsc -p tsconfig.test.json && node --test dist-test/index.test.js"
  },
  "dependencies": {
    "@rustra/types": "^0.6.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "keywords": [
    "rustra",
    "bridge",
    "node",
    "adapter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopy-lim/rustra.git",
    "directory": "packages/node"
  },
  "bugs": {
    "url": "https://github.com/loopy-lim/rustra/issues"
  },
  "homepage": "https://github.com/loopy-lim/rustra#readme"
}
