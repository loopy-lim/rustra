{
  "name": "@rustra/tauri",
  "version": "0.10.0",
  "description": "Type-safe Tauri client for rustra — one Rust core over a compact binary wire, with CI contracts that block breaking schema changes.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist dist-test",
    "test": "bun test src/index.test.ts",
    "test:compile": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@rustra/types": "^0.12.1"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "keywords": [
    "rustra",
    "tauri",
    "rust",
    "typescript",
    "ffi",
    "bindings",
    "type-safe",
    "bridge",
    "desktop",
    "codegen"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopy-lim/rustra.git",
    "directory": "packages/tauri"
  },
  "bugs": {
    "url": "https://github.com/loopy-lim/rustra/issues"
  },
  "homepage": "https://github.com/loopy-lim/rustra#readme"
}
