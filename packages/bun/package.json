{
  "name": "@rustra/bun",
  "version": "0.4.0",
  "description": "Bun adapter for rustra-bridge",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "dist/index.js",
    "dist/index.js.map"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist dist-test",
    "test": "bun test src/index.test.ts",
    "test:compile": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@rustra/types": "^0.4.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "rustra",
    "bridge",
    "bun",
    "adapter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopy-lim/rustra.git",
    "directory": "packages/bun"
  },
  "bugs": {
    "url": "https://github.com/loopy-lim/rustra/issues"
  },
  "homepage": "https://github.com/loopy-lim/rustra#readme"
}
