        ],
        "properties": {
          "sent": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0.0
          },
          "droppedSends": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0.0
          }
        }
      },
      "definitions": {
        "ChannelHandle": {
