{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "rootDir": "../..",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    // 예외: generated/frame-codecs.ts 의 인덱스 접근 위반이 89건(생성 코드,
    // noUncheckedIndexedAccess 유발)이라 플래그만 로컬 비활성한다. 생성물은
    // 코드젠 렌더러 태스크(T2) 소유라 손볼 수 없다 — 렌더러가 정리되면 이
    // 오버라이드를 제거해 base 상속을 복원한다. 나머지 4개 플래그는 그대로 상속한다.
    "noUncheckedIndexedAccess": false
  },
  "include": ["App.tsx", "index.ts", "modules/**/*.ts", "generated/**/*.ts"]
}
