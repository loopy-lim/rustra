{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "rootDir": "../..",
    "outDir": "dist",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "../calculator/generated/**/*.ts", "../../packages/tauri/src/**/*.ts"],
  "exclude": [
    "../calculator/generated/bun.ts",
    "../calculator/generated/node.ts",
    "../calculator/generated/react-native.ts"
  ]
}
